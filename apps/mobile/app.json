{
  "expo": {
    "name": "Cycla",
    "slug": "cycla-mobile",
    "version": "1.0.0",
    "scheme": "cycla",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.cycla-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#EDE9FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.cyclamobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-foreground.png",
          "color": "#7C6FCD"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDE9FE",
          "image": "./assets/splash-blank.png"
        }
      ]
    ]
  }
}
